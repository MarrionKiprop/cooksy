# Server-only OpenAI configuration. Never place real keys in this example.
OPENAI_API_KEY=
# live enables AI on explicit user actions; demo disables all provider calls.
COOKSY_LLM_MODE=live
# Model fixed to gpt-4.1-mini in ai/provider.jac and jac.toml.
# Local classifier. Missing runtime/weights yields an honest unavailable state.
COOKSY_VISION_MODE=local
# Python with Pillow, torch and torchvision installed; blank finds python3 on PATH.
COOKSY_VISION_PYTHON=
COOKSY_VISION_MODEL_PATH=
# Optional SDXL. off/local/hosted; demo is an explicit app action.
COOKSY_SDXL_MODE=off
COOKSY_SDXL_PYTHON=
COOKSY_SDXL_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
COOKSY_SDXL_MODEL_PATH=
# For our HF bundle: https://langstkip-cooksy-sdxl.hf.space/gradio_api/call/generate
COOKSY_SDXL_ENDPOINT=
COOKSY_SDXL_API_KEY=
