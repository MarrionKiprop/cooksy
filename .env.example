# M0: documentation only. These are proposed Cooksy settings, not wired runtime options.
# No environment variables or credentials are required for M0 or the planned M1 shell.
# Implement and document consumers in the relevant milestone before enabling a setting.
# Proposed M5: demo or live; live provider/model selection remains to be verified.
COOKSY_LLM_MODE=demo
COOKSY_LLM_MODEL=
# Provider-specific secret names will be added after provider selection; server only.
# Proposed M6: demo or local; a model path alone does not install dependencies.
COOKSY_VISION_MODE=demo
COOKSY_VISION_MODEL_PATH=
# Proposed M7: demo, local, or hosted; hosted contract remains to be selected.
COOKSY_SDXL_MODE=demo
COOKSY_SDXL_MODEL_PATH=
COOKSY_SDXL_ENDPOINT=
COOKSY_SDXL_API_KEY=
