# M5: server-only OpenAI configuration. Never place real keys in this example.
OPENAI_API_KEY=
# live enables AI on explicit user actions; demo disables all provider calls.
COOKSY_LLM_MODE=live
# Model fixed to gpt-4.1-mini in ai/provider.jac and jac.toml.
# Proposed M6 settings, not consumed yet.
COOKSY_VISION_MODE=demo
COOKSY_VISION_MODEL_PATH=
# Proposed M7 settings, not consumed yet.
COOKSY_SDXL_MODE=demo
COOKSY_SDXL_MODEL_PATH=
COOKSY_SDXL_ENDPOINT=
COOKSY_SDXL_API_KEY=
